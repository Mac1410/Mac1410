# Copy to .env for local use (never commit .env). On GitHub, set these as
# repository Actions secrets instead.

# Required — Anthropic API key (the model that makes decisions)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Telegram notifications
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=819108399

# Data source: leave unset locally (uses TradingView if open, else CoinGecko).
# On a headless host (GitHub Actions / cloud), set to "coingecko".
# ADVISOR_DATA_SOURCE=coingecko
